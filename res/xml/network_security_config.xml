<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- OWASP MASVS-NETWORK-1: Block all unencrypted cleartext HTTP traffic globally. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

